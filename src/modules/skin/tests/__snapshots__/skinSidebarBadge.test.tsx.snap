// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SkinSidebar session status badge — los 4 estados > "atención": círculo sólido verde con halo 1`] = `"<span data-testid="session-status-badge" data-state="attention" title="Algo llegó mientras mirabas otra sesión" class="h-2.5 w-2.5 flex-none rounded-full bg-emerald-500 ring-2 ring-emerald-500/40 ring-offset-1 ring-offset-background "></span>"`;

exports[`SkinSidebar session status badge — los 4 estados > "corriendo": círculo sólido celeste con pulso 1`] = `"<span data-testid="session-status-badge" data-state="running" title="Corriendo ahora" class="h-2.5 w-2.5 flex-none rounded-full bg-sky-500 animate-pulse ring-2 ring-sky-500/40 ring-offset-1 ring-offset-background "></span>"`;

exports[`SkinSidebar session status badge — los 4 estados > "quieta": círculo sólido gris apagado 1`] = `"<span data-testid="session-status-badge" data-state="idle" class="h-2.5 w-2.5 flex-none rounded-full bg-muted-foreground/60 "></span>"`;

exports[`SkinSidebar session status badge — los 4 estados > "seleccionada": círculo sólido del color primario con halo 1`] = `"<span data-testid="session-status-badge" data-state="selected" class="h-2.5 w-2.5 flex-none rounded-full bg-primary ring-2 ring-primary/40 ring-offset-1 ring-offset-background "></span>"`;
